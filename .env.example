# Public site URL (used for SEO sitemap / canonical metadata)
NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.pages.dev

# NO CAP frontend
# Leave blank in production so the browser uses the same-origin Pages Function proxy.
NEXT_PUBLIC_API_BASE_URL=

# Optional direct Worker URL for local/API-only testing.
# NEXT_PUBLIC_API_BASE_URL=https://nocap-worker.YOUR-SUBDOMAIN.workers.dev

# Pages Functions runtime secret (set in Cloudflare Pages project settings)
NO_CAP_API_URL=https://nocap-worker.YOUR-SUBDOMAIN.workers.dev

# Worker secrets (set with `wrangler secret put`)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_ORIGIN=https://YOUR-PROJECT.pages.dev
APP_ORIGIN=https://YOUR-PROJECT.pages.dev
ALLOWED_GITHUB_ID=
