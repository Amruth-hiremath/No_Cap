# Copy to .env.local and fill in. For v0.1 (single-user, static-first), all are optional.
# The app runs fully on localStorage without a Worker. Wire these up when you deploy the Worker.

# GitHub OAuth (single-user allow-list)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_ID=

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=

# Cloudflare (set via `wrangler secret put` for the Worker, not here)
# CLOUDFLARE_ACCOUNT_ID=
